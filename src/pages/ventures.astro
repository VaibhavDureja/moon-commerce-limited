---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';
import { company } from '../content/site';

const plans = [
  ['Discovery and sourcing', ['AI-assisted supplier discovery', 'Manufacturer and buyer matching', 'Supplier verification', 'Digital supplier profiles', 'Request-for-quotation workflows']],
  ['Trade and logistics', ['Trade compliance assistance', 'Customs documentation workflows', 'Free trade agreement guidance', 'Freight and logistics coordination', 'Shipment visibility']],
  ['Payments and communication', ['Secure payment integrations', 'Potential escrow integrations through authorised providers', 'Commercial communication tools', 'Business intelligence and market insights', 'Multilingual capabilities']]
] as const;
const markets = ['India', 'United Kingdom', 'European Union'];
const customers = ['Manufacturers', 'Importers', 'Exporters', 'Wholesalers', 'Distributors', 'SMEs', 'International procurement teams'];
---
<BaseLayout title="Ventures and SupplyCorridor | Moon Commerce Limited" description="Discover SupplyCorridor, Moon Commerce’s proposed platform for cross-border B2B sourcing, trade workflows, logistics and payments." canonical="/ventures/">
  <PageIntro label="Ventures · Supply chain infrastructure" title="SupplyCorridor" description="An early-stage B2B commerce venture exploring a unified digital platform for international sourcing and trade.">
    <div class="status"><span></span>In development</div>
  </PageIntro>
  <section class="section light">
    <div class="wrap">
      <div class="editorial">
        <h2>The problem</h2>
        <div class="stack">
          <p>International trade is often fragmented across supplier directories, freight providers, compliance processes, customs documentation, payment systems and manual communication.</p>
          <p>Small and medium-sized businesses can struggle to identify reliable suppliers, understand regulatory requirements and coordinate cross-border transactions.</p>
        </div>
      </div>
      <div class="editorial">
        <h2>The proposed platform</h2>
        <div class="stack">
          <p>SupplyCorridor aims to bring these processes together through one digital platform. The long-term ambition is to build a technology layer that supports international B2B commerce.</p>
          <a class="text-link" href={company.venture}>Visit SupplyCorridor <span class="diagonal-arrow" aria-hidden="true"></span></a>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="editorial">
        <h2>Planned capabilities</h2>
        <p>These capabilities are part of the development roadmap. Any future payment or escrow integrations would depend on authorised providers. SupplyCorridor is currently in development.</p>
      </div>
      <div class="directory">
        {plans.map(([title, items]) => (
          <article>
            <h3>{title}</h3>
            <ul class="list-grid">{items.map(item => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section light">
    <div class="wrap">
      <div class="editorial">
        <h2>Initial target markets</h2>
        <div>
          <p>Development initially focuses on the India–UK–EU trade corridor.</p>
          <ul class="label-row">{markets.map(market => <li>{market}</li>)}</ul>
        </div>
      </div>
      <div class="editorial">
        <h2>Who we’re building for</h2>
        <ul class="list-grid">{customers.map(customer => <li>{customer}</li>)}</ul>
      </div>
    </div>
  </section>
  <CallToAction title="Help shape SupplyCorridor." description="We welcome conversations with manufacturers, buyers, technology partners and organisations working to improve international trade." label="Start a Conversation" />
</BaseLayout>
