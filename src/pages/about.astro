---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';
import { company } from '../content/site';

const principles = [
  'Build around genuine business problems.',
  'Prioritise long-term value creation.',
  'Design for international scalability.',
  'Treat trust, transparency and security as fundamental.',
  'Approach innovation responsibly.',
  'Learn through experimentation and customer feedback.'
];
---
<BaseLayout title="About | Moon Commerce Limited" description="Learn about Moon Commerce, a London-based technology venture established in 2024, and its founder Vaibhav Dureja." canonical="/about/">
  <PageIntro label="About Moon Commerce" title="Intelligence. Infrastructure. Global opportunity." description="We are an independent, founder-led technology venture building the infrastructure for tomorrow’s commerce." />
  <section class="section light">
    <div class="wrap">
      <div class="editorial">
        <h2>Who we are</h2>
        <div class="stack">
          <p>Moon Commerce Limited is a UK-incorporated technology venture established in 2024. We develop commercially relevant solutions at the intersection of artificial intelligence, international business and digital transformation.</p>
          <p>From London, we bring an international perspective to identifying opportunities, developing products and exploring new approaches to complex business challenges.</p>
        </div>
      </div>
      <div class="editorial">
        <h2>Our mission</h2>
        <p>To simplify complex business processes through intelligent technology, enabling businesses to operate, connect and grow across borders.</p>
      </div>
      <div class="editorial">
        <h2>Our vision</h2>
        <p>To build globally scalable technology ventures that make commerce more accessible, transparent, efficient and interconnected.</p>
      </div>
      <div class="editorial">
        <h2>Our philosophy</h2>
        <div class="stack">
          <p>Technology should make meaningful business problems easier to solve. We believe successful technology businesses combine commercial understanding, technical innovation, thoughtful product design and disciplined execution.</p>
          <ul class="list-grid">{principles.map(principle => <li>{principle}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="founder">
    <div class="wrap editorial">
      <div class="stack">
        <p class="eyebrow"><span></span>Founder</p>
        <h2>Vaibhav Dureja</h2>
      </div>
      <div>
        <p>Vaibhav Dureja is a technology-focused entrepreneur with a background in international business, commercial development, marketing, B2B partnerships and multi-site operations across India and the United Kingdom.</p>
        <p>He holds an MSc in International Business from Birkbeck, University of London, and a Bachelor of Business Administration from Amity University. His postgraduate research examined the implications of artificial intelligence, blockchain and the Internet of Things for international business and is publicly available through SSRN.</p>
        <p>He has independently explored artificial intelligence, agentic systems, prompt engineering, data analytics and digital product prototyping. At the University of London, his leadership roles included President of the Indian Society, Chair of the Student Parliament and Chair of university governance panels.</p>
        <p>His focus is translating emerging technologies into commercially relevant products and globally scalable business opportunities.</p>
        <div class="profile-links">
          <a class="text-link" href={company.founder.site}>Personal website <span class="diagonal-arrow" aria-hidden="true"></span></a>
          <a class="text-link" href={company.founder.linkedin}>LinkedIn <span class="diagonal-arrow" aria-hidden="true"></span></a>
          <a class="text-link" href={company.founder.research}>SSRN research <span class="diagonal-arrow" aria-hidden="true"></span></a>
          <a class="text-link" href={company.founder.github}>GitHub <span class="diagonal-arrow" aria-hidden="true"></span></a>
        </div>
      </div>
    </div>
  </section>
  <CallToAction title="Work with Moon Commerce." description="We welcome conversations about technology, international business and the early development of SupplyCorridor." label="Partner With Us" />
</BaseLayout>
